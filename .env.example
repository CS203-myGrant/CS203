# Local development template. Put real credentials in your platform secret store.
DATABASE_URL=jdbc:postgresql://localhost:5432/policy_impact
DATABASE_USERNAME=policy_user
DATABASE_PASSWORD=
POSTGRES_DB=policy_impact
POSTGRES_USER=policy_user
POSTGRES_PASSWORD=

# Generate a Base64-encoded signing key with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# WorkOS sign-in and webhook integration.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:8080/api/v1/auth/workos/callback
WORKOS_WEBHOOK_SECRET=

# External AI and email providers. Keep credentials in environment secrets.
# OPENAI_API_KEY is used for RAG embeddings and answers.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODEL=gpt-6.1-sol
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_JUDGE_MODEL=claude-haiku-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_BASE_URL=http://localhost:8080
