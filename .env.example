# Local development template. Put real credentials in your platform secret store.
DATABASE_URL=jdbc:postgresql://localhost:5432/policy_impact
DATABASE_USERNAME=policy_user
DATABASE_PASSWORD=
POSTGRES_DB=policy_impact
POSTGRES_USER=policy_user
POSTGRES_PASSWORD=

# Generate a Base64-encoded signing key with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# Local Ollama endpoint; use a reachable endpoint URL in hosted environments.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
OLLAMA_CHAT_MODEL=llama3.2
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Optional; Optional placeholders for the CS203-80 WorkOS connector; confirm names before use.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=
WORKOS_WEBHOOK_SECRET=
